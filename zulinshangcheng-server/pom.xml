        <joda.time.version>2.9.9</joda.time.version>
        <json-lib.version>2.4</json-lib.version>
        <java-jwt.version>3.8.3</java-jwt.version>
        <jwks-rsa.version>0.12.0</jwks-rsa.version>
        <httpclient.verison>4.5.14</httpclient.verison>
        <aliyun-sdk-oss.verison>3.4.0</aliyun-sdk-oss.verison>
        <aliyun-java-sdk-core.version>4.5.3</aliyun-java-sdk-core.version>
    </properties>

