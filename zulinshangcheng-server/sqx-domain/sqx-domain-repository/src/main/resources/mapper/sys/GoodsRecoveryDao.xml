<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sqx.domain.repository.mapper.sys.GoodsRecoveryDao">

    <resultMap id="BaseResultMap" type="com.sqx.domain.repository.entity.sys.GoodsRecovery">
            <id property="id" column="id" jdbcType="INTEGER"/>
            <result property="name" column="name" jdbcType="VARCHAR"/>
            <result property="brandId" column="brand_id" jdbcType="INTEGER"/>
            <result property="createBy" column="create_by" jdbcType="INTEGER"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="deleteFlag" column="delete_flag" jdbcType="INTEGER"/>
            <result property="updateBy" column="update_by" jdbcType="INTEGER"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,name,brand_id,
        specifications_name,price,create_by,
        create_time,delete_flag,update_by,
        update_time
    </sql>
    <select id="selectListByBrandId" resultType="com.sqx.domain.repository.entity.sys.GoodsRecovery">
        select gr.*,lt.brand_name as brandName
            from goods_recovery gr
            left join brand lt on lt.id = gr.brand_id
        where gr.delete_flag = 0
          <if test="name != null and name != ''">
              and gr.name like concat('%',#{name},'%')
          </if>
          <if test="brandId != null and brandId != ''">
              and gr.brand_id = #{brandId}
          </if>
    </select>
</mapper>
